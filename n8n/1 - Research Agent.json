      "id": "5a9ed188-dcf4-4ab3-afb9-074696e36ede",
      "name": "Merge RSS Feeds"
    },
    {
      "parameters": {
        "jsCode": "// Sammle Artikel aus allen 5 RSS Feeds\nconst sources = {\n  0: \"VentureBeat\",\n  1: \"The Verge AI\",\n  2: \"Wired AI\",\n  3: \"Import AI\",\n  4: \"MIT Tech Review\"\n};\n\nconst allArticles = [];\n\nfor (let i = 0; i < $input.all().length; i++) {\n  const item = $input.all()[i].json;\n  const sourceName = sources[i] || \"Unknown\";\n\n  let articles = [];\n  if (item.rss && item.rss.channel && item.rss.channel.item) {\n    articles = Array.isArray(item.rss.channel.item)\n      ? item.rss.channel.item\n      : [item.rss.channel.item];\n  }\n\n  for (const article of articles.slice(0, 5)) {\n    const title = typeof article.title === 'string'\n      ? article.title\n      : (article.title?._ || article.title?.['#text'] || 'No title');\n\n    const description = typeof article.description === 'string'\n      ? article.description\n      : (article.summary?._ || article.summary || article['content:encoded'] || '');\n\n    const link = typeof article.link === 'string'\n      ? article.link\n      : (article.link?.href || article.link?._ || '');\n\n    const cleanDescription = String(description)\n      .replace(/<[^>]*>/g, '')\n      .replace(/\\s+/g, ' ')\n      .trim()\n      .substring(0, 500);\n\n    allArticles.push({\n      title: String(title).trim(),\n      description: cleanDescription,\n      link: String(link),\n      source: sourceName\n    });\n  }\n}\n\nconst limitedArticles = allArticles.slice(0, 20);\nconst articlesAsString = JSON.stringify(limitedArticles, null, 2);\n\nconst systemPrompt = \"Du bist Research Agent fuer die Lufthansa Finance Training Academy. Deine Aufgabe: aus aktuellen AI-News konkrete, benennbare KI-TECHNOLOGIEN extrahieren, die spaeter in einem Dropdown zur Spiel-Erstellung ausgewaehlt werden.\\n\\nAUFGABE: Waehle aus den gelieferten Artikeln NUR echte, konkret benennbare KI-Technologien, -Faehigkeiten oder -Tools aus (z.B. \\\"AI Agents\\\", \\\"Agent Skills\\\", \\\"Copilot Connectors\\\", \\\"Model Context Protocol\\\"). Produktnamen sind hier ERWUENSCHT, wenn sie die Technologie eindeutig benennen.\\n\\nAUSSCHLUSS - ignoriere vollstaendig:\\n- Forschungsartikel, Benchmarks, akademische Papers\\n- Meinungsbeitraege, Spekulationen, AGI-Zukunftsdebatten\\n- reine Firmen-PR ohne konkrete neue Technologie\\n\\nEINSCHLUSS (mindestens eines muss zutreffen):\\n1. Neue, konkret benennbare KI-Technologie oder neues Tool\\n2. Neue KI-Faehigkeit, die Arbeitsablaeufe spuerbar veraendert\\n3. Technologie, die ein nicht-technischer Mensch konzeptuell verstehen kann\\n\\nWICHTIG: Verwende NUR die gelieferten Artikel. Erfinde nichts. Wenn weniger als 5 die Kriterien erfuellen, gib weniger zurueck.\\n\\nGib AUSSCHLIESSLICH valides JSON zurueck, KEINE Markdown-Code-Bloecke, in diesem Format:\\n{\\\"collected_at\\\":\\\"<datum>\\\",\\\"technologies\\\":[{\\\"label\\\":\\\"<kurzes Technologie-Label, max 6 Woerter, Produktname erlaubt>\\\",\\\"whats_new\\\":\\\"<ein deutscher Satz: was diese Technologie neu kann, sachlich, keine Marketing-Sprache>\\\",\\\"source_url\\\":\\\"<link>\\\",\\\"source_name\\\":\\\"<source>\\\"}]}\";\n\nconst userPrompt = \"Hier sind echte Artikel aus aktuellen AI-RSS-Feeds. Waehle die relevantesten Technologien aus:\\n\\n\" + articlesAsString;\n\nconst llmBody = {\n  model: \"OpenAI GPT OSS 120b KI:Inferenz.nrw\",\n  messages: [\n    { role: \"system\", content: systemPrompt },\n    { role: \"user\", content: userPrompt }\n  ],\n  temperature: 0.3\n};\n\nreturn [{\n  json: {\n    article_count: limitedArticles.length,\n    llm_body: llmBody\n  }\n}];"
      },
