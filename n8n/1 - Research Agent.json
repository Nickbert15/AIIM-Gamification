      "name": "Output – Research Agent"
    },
    {
      "parameters": {
        "jsCode": "// Parse LLM JSON-Antwort und mappe Felder fuer Supabase-Tabelle \"technologies\"\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const raw = item.json.research_output || '';\n\n  let parsed;\n  try {\n    parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n  } catch (e) {\n    continue;\n  }\n\n  const techs = parsed.technologies || parsed || [];\n  const techArray = Array.isArray(techs) ? techs : [techs];\n\n  for (const t of techArray) {\n    if (!t || !t.label) continue;\n\n    results.push({\n      json: {\n        label: String(t.label || '').trim().substring(0, 100),\n        whats_new: String(t.whats_new || '').trim().substring(0, 500),\n        source_url: String(t.source_url || t.link || '').trim().substring(0, 500),\n        source_name: String(t.source_name || t.source || '').trim().substring(0, 100),\n        created_at: new Date().toISOString()\n      }\n    });\n  }\n}\n\nreturn results;"
      },
